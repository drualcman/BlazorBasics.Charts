<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>1.4.20</Version>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>Sergi Ortiz Gomez</Authors>
		<Company>DrUalcman</Company>
		<Description>Simple Charts (Pie, Columns, Bars, Stacked bars, Lines, Ring percentage) to use in Razor Projects.</Description>
		<Copyright>Free</Copyright>
		<RepositoryUrl>https://github.com/drualcman/BlazorBasics.Charts</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>charts;pie;bars;stacked;lines;ring;percentage;blazor;blazor server; blazor webassembly</PackageTags>
		<PackageId>BlazorBasics.Charts</PackageId>
		<Product>BlazorBasics.Charts</Product>
		<PackageReleaseNotes>BREAKING CHANGES: removed the options that had no effect. PieChartParams loses Saturation and Luminosity, together with their constructor parameters, so a PieChartParams built with positional arguments must name them instead. ColumnWithLineChartParams loses Width and BackgroundColor. New: net11.0, and Microsoft.AspNetCore.Components.Web updated to the latest version of every framework. Fixes: the X labels and grid lines of the Line chart are placed by their X when a series has more points than MaxPointPerLine, so they no longer come out of order or pile up on the right. RingPercentageComponent no longer writes an invalid size when Width is zero, applies Height on its own, keeps its text readable without a Width, and every ring gets its own gradient, so two rings with different colours on the same page no longer share the colours of the first one. The legend of ColumnWithLineChartComponent shows the secondary line in its own colour. The README documents every component, parameter and option.</PackageReleaseNotes>
		<PackageProjectUrl>https://github.com/drualcman/BlazorBasics.Charts</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="ColumnWithLineChartComponent.razor.css" />
		<EmbeddedResource Include="ColumnChartComponent.razor.css" />
		<EmbeddedResource Include="StackedBarChartComponent.razor.css" />
		<EmbeddedResource Include="LineChartComponent.razor.css" />
		<EmbeddedResource Include="PieChartComponent.razor.css" />
		<EmbeddedResource Include="RingPercentageComponent.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon-512.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.34" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>

</Project>
