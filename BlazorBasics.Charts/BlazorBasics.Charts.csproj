<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>1.3.19</Version>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>Sergi Ortiz Gomez</Authors>
		<Company>DrUalcman</Company>
		<Description>Simple Charts (Pie, Columns, Bars, Stacked bars, Lines, Ring percentage) to use in Razor Projects.</Description>
		<Copyright>Free</Copyright>
		<RepositoryUrl>https://github.com/drualcman/BlazorBasics.Charts</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>charts;pie;bars;stacked;lines;ring;percentage;blazor;blazor server; blazor webassembly</PackageTags>
		<PackageId>BlazorBasics.Charts</PackageId>
		<Product>BlazorBasics.Charts</Product>
		<PackageReleaseNotes>New StackedBarChartComponent, one single bar split into the share every value takes of the whole, in either orientation. Column and Bar charts take a ColumnFillReference to fill against the highest value or against the total, and a ColumnLabelPlacement to put the labels at the bottom, top, left or right. Column chart labels can be rotated, and their font size is configurable. Existing charts keep their previous look.</PackageReleaseNotes>
		<PackageProjectUrl>https://github.com/drualcman/BlazorBasics.Charts</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="ColumnWithLineChartComponent.razor.css" />
		<EmbeddedResource Include="ColumnChartComponent.razor.css" />
		<EmbeddedResource Include="StackedBarChartComponent.razor.css" />
		<EmbeddedResource Include="LineChartComponent.razor.css" />
		<EmbeddedResource Include="PieChartComponent.razor.css" />
		<EmbeddedResource Include="RingPercentageComponent.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon-512.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.30" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.19" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>

</Project>
